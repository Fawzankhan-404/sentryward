+
+export async function search(term: string, limit = 20): Promise<Product[]> {
+  const sql = `SELECT id, name, price_cents FROM ${TABLE} WHERE name ILIKE '%${term}%' ORDER BY name LIMIT ${limit}`;
+  const { rows } = await pool.query(sql);
+  return rows;
+}

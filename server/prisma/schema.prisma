generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

// Instance-wide role. Admins manage who can use this Sentryward install; it grants
// no access to other users' repositories or reviews.
enum InstanceRole {
  admin
  member

  @@map("instance_role")
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  email           String       @unique @db.Citext
  passwordHash    String       @map("password_hash")
  role            InstanceRole @default(member)
  // Set while the user has a profile picture; also its cache-busting version.
  avatarUpdatedAt DateTime?    @map("avatar_updated_at") @db.Timestamptz
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  avatar             UserAvatar?
  personalWorkspace  Workspace?        @relation("PersonalWorkspace")
  memberships        Membership[]
  connectionsCreated ForgeConnection[]
  invitesSent        Invite[]

  @@map("users")
}

// Kept apart from users so listing users never loads image bytes. The browser
// uploads an already cropped and downsized image.
model UserAvatar {
  userId    String   @id @map("user_id") @db.Uuid
  data      Bytes
  mimeType  String   @map("mime_type")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatars")
}

// Owns connections (and through them repositories, reviews and findings), LLM
// credentials and the global review config. Every user has a personal one, so
// a solo user never sees the difference.
model Workspace {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  // Set only on a user's personal workspace: at most one each, deleted with them.
  personalOwnerId String?  @unique @map("personal_owner_id") @db.Uuid
  // Global review config: a ConfigOverride applied to every repository that
  // follows it (and beneath the overrides of those that do not).
  reviewSettings  Json     @default("{}") @map("review_settings")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  personalOwner  User?             @relation("PersonalWorkspace", fields: [personalOwnerId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  connections    ForgeConnection[]
  llmCredentials LlmCredential[]
  invites        Invite[]

  @@map("workspaces")
}

// Declared most privileged first.
enum WorkspaceRole {
  owner
  admin
  member

  @@map("workspace_role")
}

model Membership {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

// A one-time link to register, or with a workspace, to join it (registering
// first if needed). Only a hash of the token is stored, so a database read does
// not yield usable links.
model Invite {
  id          String         @id @default(uuid()) @db.Uuid
  tokenHash   String         @unique @map("token_hash")
  // When set, only this address can use the invite.
  email       String?        @db.Citext
  workspaceId String?        @map("workspace_id") @db.Uuid
  // The role granted on joining; set exactly when workspaceId is.
  role        WorkspaceRole?
  invitedById String?        @map("invited_by_id") @db.Uuid
  expiresAt   DateTime       @map("expires_at") @db.Timestamptz
  acceptedAt  DateTime?      @map("accepted_at") @db.Timestamptz
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz

  invitedBy User?      @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("invites")
}

enum ForgeProvider {
  github
  gitlab

  @@map("forge_provider")
}

enum ConnectionKind {
  github_app
  token

  @@map("connection_kind")
}

enum ReviewTrigger {
  manual
  webhook
  comment

  @@map("review_trigger")
}

enum ReviewStatus {
  queued
  running
  completed
  partial
  failed
  superseded
  // The trigger did not call for a review (auto-review off, a draft).
  skipped
  // The PR/MR was closed or merged before the review finished.
  cancelled

  @@map("review_status")
}

enum ReviewVerdict {
  pass
  blocked
  error

  @@map("review_verdict")
}

enum FindingState {
  open
  resolved
  ignored

  @@map("finding_state")
}

// Declared most severe first: Postgres orders an enum by declaration, so the
// findings list can sort by rank.
enum FindingSeverity {
  critical
  major
  minor
  info

  @@map("finding_severity")
}

// Why the user dismissed a finding, chosen when ignoring it.
enum IgnoreReason {
  false_positive
  intentional
  fix_later
  not_specified

  @@map("ignore_reason")
}

model ForgeConnection {
  id             String         @id @default(uuid()) @db.Uuid
  workspaceId    String         @map("workspace_id") @db.Uuid
  // Who connected it, for display; the workspace owns it.
  createdById    String?        @map("created_by_id") @db.Uuid
  provider       ForgeProvider
  host           String
  kind           ConnectionKind
  installationId String?        @map("installation_id")
  encryptedToken String?        @map("encrypted_token")
  accountLogin   String         @map("account_login")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  repositories Repository[]

  @@index([workspaceId])
  @@map("forge_connections")
}

model Repository {
  id                     String        @id @default(uuid()) @db.Uuid
  connectionId           String        @map("connection_id") @db.Uuid
  provider               ForgeProvider
  host                   String
  fullPath               String        @map("full_path")
  externalId             String        @map("external_id")
  defaultBranch          String        @map("default_branch")
  enabled                Boolean       @default(false)
  settings               Json          @default("{}")
  // When set, `settings` is ignored and only the workspace's global config applies.
  followGlobal           Boolean       @default(true) @map("follow_global")
  // GitLab project hook Sentryward registered, and the secret GitLab sends with it.
  webhookId              String?       @map("webhook_id")
  encryptedWebhookSecret String?       @map("encrypted_webhook_secret")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  connection     ForgeConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  reviewJobs     ReviewJob[]
  postedFindings PostedFinding[]
  findings       Finding[]

  @@unique([connectionId, externalId])
  @@map("repositories")
}

model ReviewJob {
  id             String         @id @default(uuid()) @db.Uuid
  repositoryId   String         @map("repository_id") @db.Uuid
  number         Int
  headSha        String         @map("head_sha")
  baseSha        String?        @map("base_sha")
  trigger        ReviewTrigger
  // For webhook jobs, whether the change was opened ("open") or received new
  // commits ("push"); trigger settings treat the two differently.
  event          String?
  // Forge login of whoever opened, pushed or commented, for the author skip list.
  actor          String?
  status         ReviewStatus   @default(queued)
  verdict        ReviewVerdict?
  resolvedConfig Json?          @map("resolved_config")
  result         Json?
  // Small digest of the result (title, counts) so lists never load results.
  summary        Json?
  // What was posted to the forge: inline comments, summary, commit status.
  publication    Json?
  error          String?
  attempts       Int            @default(0)
  lockedAt       DateTime?      @map("locked_at") @db.Timestamptz
  startedAt      DateTime?      @map("started_at") @db.Timestamptz
  finishedAt     DateTime?      @map("finished_at") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  findings   Finding[]

  @@index([status, createdAt])
  @@index([repositoryId, number])
  @@map("review_jobs")
}

model PostedFinding {
  id             String   @id @default(uuid()) @db.Uuid
  repositoryId   String   @map("repository_id") @db.Uuid
  number         Int
  fingerprint    String
  forgeCommentId String   @map("forge_comment_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, number, fingerprint])
  @@map("posted_findings")
}

// One finding on one pull/merge request across all its runs, keyed like
// PostedFinding. The worker keeps it in step with each run's result (open while
// a run still reports it, resolved once a run that read its file does not);
// "ignored" is only ever set by the user and survives later runs.
model Finding {
  id           String          @id @default(uuid()) @db.Uuid
  repositoryId String          @map("repository_id") @db.Uuid
  number       Int
  fingerprint  String
  state        FindingState    @default(open)
  // Snapshot from the latest run that reported it, so lists never load results.
  title        String
  file         String
  startLine    Int             @map("start_line")
  severity     FindingSeverity
  category     String
  kind         String
  changeTitle  String          @map("change_title")
  // Forge login of whoever opened the change; unknown for backfilled rows.
  author       String?
  lastJobId    String?         @map("last_job_id") @db.Uuid
  firstSeenAt  DateTime        @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt   DateTime        @default(now()) @map("last_seen_at") @db.Timestamptz
  resolvedAt   DateTime?       @map("resolved_at") @db.Timestamptz
  ignoredAt    DateTime?       @map("ignored_at") @db.Timestamptz
  // Set together with ignoredAt and cleared on reopen.
  ignoreReason IgnoreReason?   @map("ignore_reason")
  ignoreNote   String?         @map("ignore_note")
  // The forge thread could not be moved to match `state` (a failed resolve or
  // reopen). Later runs retry it until the forge agrees.
  threadPending Boolean        @default(false) @map("thread_pending")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  lastJob    ReviewJob? @relation(fields: [lastJobId], references: [id], onDelete: SetNull)

  @@unique([repositoryId, number, fingerprint])
  @@index([repositoryId, state])
  @@map("findings")
}

model LlmCredential {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  provider     String
  encryptedKey String?  @map("encrypted_key")
  baseUrl      String?  @map("base_url")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@map("llm_credentials")
}

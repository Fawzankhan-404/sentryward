# Production settings for docker-compose.prod.yml. See "Deploying" in the README.
# Copy to .env.production, fill in every value marked required, and keep the
# file out of version control.

# Image tag to run, e.g. 0.1.0. "latest" follows the newest stable release.
SENTRYWARD_VERSION=latest

# Database (required: POSTGRES_PASSWORD). Generate with: openssl rand -hex 24
POSTGRES_USER=sentryward
POSTGRES_PASSWORD=
POSTGRES_DB=sentryward

# Required. Generate each with: openssl rand -hex 32
JWT_SECRET=
# Encrypts forge tokens and LLM keys at rest. Keep it stable and back it up
# separately: changing it makes stored credentials unreadable.
ENCRYPTION_KEY=

# Required. The public HTTPS URL of this instance, used for both: the API
# serves the dashboard, so they share one origin.
CLIENT_ORIGIN=https://sentryward.example.com
API_PUBLIC_URL=https://sentryward.example.com

# Reverse proxy hops in front of the API (1 for a single proxy).
TRUST_PROXY=1
# Port the API listens on, on the host's loopback interface by default.
API_HOST_PORT=4000
API_BIND=127.0.0.1

# Who can create an account: open, invite (invite links only) or closed.
# The first account is always allowed and becomes the instance admin.
REGISTRATION_MODE=invite
# Optional SMTP transport for invite emails, e.g. smtp://user:pass@smtp.example.com:587
SMTP_URL=
MAIL_FROM=

# GitHub App (optional; GitHub connections are disabled without it). See README.
GITHUB_HOST=github.com
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The app's private key on one line, newlines written as \n
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Model keys used by the worker when a user has not stored their own (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
